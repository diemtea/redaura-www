# Resend API Key for sending emails
RESEND_API_KEY=your_resend_api_key_here

# Recipient email address for pilot signup notifications
TO_EMAIL=hello@redaura.app

# Sender email address
# Note: Use 'onboarding@resend.dev' for initial testing, or 'hello@redaura.app' once domain is verified in Resend.
FROM_EMAIL=Redaura Pilot <onboarding@resend.dev>
